# =============================================================================
# JurisAI — Production & Deployment Environment Configuration
# =============================================================================

# Server Environment Mode ('production' or 'development')
NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# MongoDB Atlas Database Configuration (Required for Production)
# -----------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
#
# QUICK ATLAS SETUP GUIDE:
# 1. Sign up at https://www.mongodb.com/cloud/atlas and create a FREE cluster (M0).
# 2. Go to "Security" -> "Database Access":
#    - Add a new database user (e.g. "jurisai_admin") with password authentication.
#    - Assign "Read and write to any database" role.
# 3. Go to "Security" -> "Network Access":
#    - Add IP Address: 0.0.0.0/0 (Allows cloud hosting platforms like Render, AWS, Railway to connect).
# 4. Go to "Database" -> "Connect" -> "Drivers" (Node.js):
#    - Copy your connection string and paste it below.
#    - Replace <password> with your user's password (remove the '<>' characters).
#    - If password has special characters (@, #, &, %), URL-encode them (@ -> %40).
#    - Ensure the database name is set to /jurisai before the '?' query string.
#
# Test your connection anytime by running: npm run test:db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jurisai?retryWrites=true&w=majority

# Optional MongoDB Pool Tuning:
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Set a strong, cryptographically secure random string for JWT signing
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_passphrase_for_production

# -----------------------------------------------------------------------------
# CORS & Allowed Origins
# -----------------------------------------------------------------------------
# The public domain of your frontend application
CLIENT_URL=https://your-frontend-domain.com
# Additional allowed origins (comma-separated, without trailing slashes)
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://jurisai.vercel.app

# -----------------------------------------------------------------------------
# AI Evaluation Service
# -----------------------------------------------------------------------------
# In single-server or local docker: http://localhost:8000
# In distributed cloud deployment: https://your-ai-service-domain.com
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=generate_a_secure_random_service_key_for_internal_ai_calls

# -----------------------------------------------------------------------------
# Gmail / SMTP Email Notifications (Optional but Recommended)
# -----------------------------------------------------------------------------
# Leave SMTP_PASS blank to test in console log mode.
# To send real emails:
# 1. Set SMTP_USER to your Gmail address.
# 2. Generate a 16-character Google App Password:
#    (Google Account -> Security -> 2-Step Verification -> App passwords).
# 3. Set SMTP_PASS to that 16-character App Password (no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# AI Service Backend (Python FastAPI)
# -----------------------------------------------------------------------------
SERVICE_KEY=generate_a_secure_random_service_key_for_internal_ai_calls
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-flash
CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Set to your deployed backend API URL (or /api if served on the same domain)
VITE_API_URL=https://your-backend-domain.com/api
