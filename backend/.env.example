# =============================================================================
# JurisAI — Backend Production Environment Configuration
# =============================================================================

NODE_ENV=production
PORT=5000

# -----------------------------------------------------------------------------
# MongoDB Atlas Cloud Database URI
# -----------------------------------------------------------------------------
# Replace with your MongoDB Atlas connection string.
# Ensure IP 0.0.0.0/0 is whitelisted in Atlas Network Access.
# Test connection with: npm run test:db
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/jurisai?retryWrites=true&w=majority

# Optional Connection Pool Tuning
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT=10000

# -----------------------------------------------------------------------------
# JWT Secret (Must be set to a secure random string in production)
# -----------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_64_character_hex_or_passphrase_for_production

# -----------------------------------------------------------------------------
# CORS Allowed Client Domain
# -----------------------------------------------------------------------------
CLIENT_URL=https://your-frontend-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://jurisai.vercel.app

# -----------------------------------------------------------------------------
# AI Evaluation Service Endpoint & Internal Key
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_KEY=secret_internal_service_key

# -----------------------------------------------------------------------------
# Gmail / SMTP Notifications (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
